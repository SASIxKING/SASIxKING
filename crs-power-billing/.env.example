# ---------------------------------------------------------------------------
# Payment gateway credentials.
#
# Copy this file to `.env` and fill in the keys for whichever gateway you use.
# Leave a gateway blank to keep it in SIMULATION mode (safe for testing —
# orders are created and invoices update, but no real money moves).
#
# NEVER commit the real .env file. These are SERVER-SIDE secrets: the browser
# only ever receives the publishable key id, never the secret/salt.
# ---------------------------------------------------------------------------

# Razorpay — dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cashfree — merchant.cashfree.com → Developers → API Keys
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# PayU — onboarding.payu.in → Merchant key & salt
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=

# API server port (the Vite dev server proxies /api to this)
PORT=8787
