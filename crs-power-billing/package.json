{
  "name": "crs-power-billing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Billing, inventory and GST software for C.R.S Power Solution \u2014 inverters & batteries, Pondicherry",
  "author": "C.R.S Power Solution",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "desktop:dev": "concurrently -k -n VITE,ELECTRON -c cyan,green \"npm:dev:web\" \"wait-on tcp:5173 && electron .\"",
    "desktop:build": "npm run build:windows && electron-builder --win --publish never",
    "desktop:dir": "npm run build:windows && electron-builder --win --dir --publish never",
    "android:sync": "npm run build:android && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "build:android": "vite build",
    "build:windows": "vite build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.12",
    "typescript": "^5.6.2",
    "vite": "^5.4.6",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "in.crspower.billing",
    "productName": "CRS Power Billing",
    "copyright": "C.R.S Power Solution, Pondicherry",
    "directories": {
      "output": "release",
      "buildResources": "electron"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png",
      "artifactName": "CRS-Power-Billing-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CRS Power Billing"
    },
    "portable": {
      "artifactName": "CRS-Power-Billing-Portable-${version}.exe"
    }
  }
}